# Excluded AI Tools & Repositories
rtk/
ponytail/

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/

# Testing & Coverage
coverage/
*.lcov

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and local configs
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Linter and tool caches
.oxlint-cache
.eslintcache
.cache/
.vite/
.turbo/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# OS specific files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
